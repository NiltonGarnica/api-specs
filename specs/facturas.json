{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Facturas",
    "version": "1.0.0",
    "description": "API de demostración para consultar y emitir facturas. Los datos y endpoints son ficticios y solo sirven como documentación de ejemplo.",
    "contact": {
      "name": "Equipo de APIs (demostración)"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://api.ejemplo.com/v1",
      "description": "Servidor de demostración (no real)"
    }
  ],
  "tags": [
    {
      "name": "Facturas",
      "description": "Operaciones sobre facturas"
    }
  ],
  "paths": {
    "/facturas": {
      "get": {
        "tags": ["Facturas"],
        "operationId": "listarFacturas",
        "summary": "Listar facturas",
        "description": "Devuelve las facturas registradas. Se pueden filtrar por estado y limitar la cantidad de resultados.",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "description": "Filtra por estado de la factura.",
            "schema": {
              "type": "string",
              "enum": ["pendiente", "pagada", "anulada"]
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "description": "Cantidad máxima de facturas a devolver.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de facturas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Factura"
                  }
                },
                "example": [
                  {
                    "id": "FAC-0001",
                    "clienteId": "CLI-001",
                    "fecha": "2026-11-01",
                    "moneda": "PEN",
                    "lineas": [
                      { "descripcion": "Desarrollo web", "cantidad": 1, "precioUnitario": 1500.0 }
                    ],
                    "total": 1500.0,
                    "estado": "pagada"
                  },
                  {
                    "id": "FAC-0002",
                    "clienteId": "CLI-002",
                    "fecha": "2026-11-05",
                    "moneda": "PEN",
                    "lineas": [
                      { "descripcion": "Hosting anual", "cantidad": 1, "precioUnitario": 300.0 },
                      { "descripcion": "Dominio .com", "cantidad": 2, "precioUnitario": 50.0 }
                    ],
                    "total": 400.0,
                    "estado": "pendiente"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Facturas"],
        "operationId": "crearFactura",
        "summary": "Crear una factura",
        "description": "Registra una nueva factura para un cliente. El total se calcula a partir de las líneas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NuevaFactura"
              },
              "example": {
                "clienteId": "CLI-001",
                "fecha": "2026-11-09",
                "moneda": "PEN",
                "lineas": [
                  { "descripcion": "Consultoría", "cantidad": 3, "precioUnitario": 200.0 },
                  { "descripcion": "Soporte mensual", "cantidad": 1, "precioUnitario": 150.0 }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Factura creada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Factura"
                },
                "example": {
                  "id": "FAC-0003",
                  "clienteId": "CLI-001",
                  "fecha": "2026-11-09",
                  "moneda": "PEN",
                  "lineas": [
                    { "descripcion": "Consultoría", "cantidad": 3, "precioUnitario": 200.0 },
                    { "descripcion": "Soporte mensual", "cantidad": 1, "precioUnitario": 150.0 }
                  ],
                  "total": 750.0,
                  "estado": "pendiente"
                }
              }
            }
          },
          "400": {
            "description": "Datos de la factura no válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "codigo": "DATOS_INVALIDOS",
                  "mensaje": "La factura debe tener al menos una línea."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LineaFactura": {
        "type": "object",
        "required": ["descripcion", "cantidad", "precioUnitario"],
        "properties": {
          "descripcion": { "type": "string", "example": "Consultoría" },
          "cantidad": { "type": "integer", "minimum": 1, "example": 3 },
          "precioUnitario": { "type": "number", "format": "double", "minimum": 0, "example": 200.0 }
        }
      },
      "NuevaFactura": {
        "type": "object",
        "required": ["clienteId", "fecha", "moneda", "lineas"],
        "properties": {
          "clienteId": { "type": "string", "example": "CLI-001" },
          "fecha": { "type": "string", "format": "date", "example": "2026-11-09" },
          "moneda": { "type": "string", "enum": ["PEN", "USD"], "example": "PEN" },
          "lineas": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/LineaFactura" }
          }
        }
      },
      "Factura": {
        "allOf": [
          { "$ref": "#/components/schemas/NuevaFactura" },
          {
            "type": "object",
            "required": ["id", "total", "estado"],
            "properties": {
              "id": { "type": "string", "example": "FAC-0003" },
              "total": { "type": "number", "format": "double", "example": 750.0 },
              "estado": { "type": "string", "enum": ["pendiente", "pagada", "anulada"], "example": "pendiente" }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": ["codigo", "mensaje"],
        "properties": {
          "codigo": { "type": "string", "example": "DATOS_INVALIDOS" },
          "mensaje": { "type": "string", "example": "La factura debe tener al menos una línea." }
        }
      }
    }
  }
}
